# 配置文件（YAML）：默认读当前目录 config.yaml，不存在则忽略；显式指定却缺失会启动失败
# 优先级：环境变量 > .env > 配置文件 > 内置默认值。示例见 config.example.yaml
CONFIG_FILE=config.yaml

# 服务
PORT=8080
LOG_LEVEL=info

# 数据库：sqlite | mysql | postgres
DB_DRIVER=sqlite
DB_DSN=data/graycrow.db
# mysql 示例：DB_DSN=graycrow:graycrow@tcp(127.0.0.1:3306)/graycrow?charset=utf8mb4&parseTime=True&loc=UTC
# pg 示例：  DB_DSN=host=127.0.0.1 user=graycrow password=graycrow dbname=graycrow port=5432 sslmode=disable TimeZone=UTC

# 必填：>=32 字符，用于 AES-GCM 加密 API Key 与渠道密钥
# 生成：openssl rand -base64 48
MASTER_KEY=
# 轮换密钥时：把旧值填这里（多个用逗号分隔），启动后会自动用新密钥重加密所有密文字段，完成后即可删除此行
MASTER_KEY_OLD=

SESSION_TTL_HOURS=168
# 生产环境（HTTPS）置 true
COOKIE_SECURE=false

# 首次启动且无用户时自动创建的管理员
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# 扫描引擎
SCAN_ENABLED=true
SCAN_MIN_INTERVAL_SEC=60
# cron 表达式的解释时区（IANA 名称）
SCAN_TIMEZONE=Asia/Shanghai
API_RATE_PER_MIN=8
# 自建 GitHub Enterprise 实例地址，留空使用官方 api.github.com
GITHUB_API_BASE=

# 前端（web/.env.local）
# VITE_USE_MOCK=1
# VITE_API_BASE=/api/v1
